default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    // Base layout - change "us" to your actual layout (e.g. "gb", "de", "fr", etc.)
    include "pc(pc105)"
    include "us(basic)"      // ← Change this line if you use a different base layout

    // Optional: keep other common includes (media keys, etc.)
    include "inet(evdev)"

    // Completely disable Left Alt (produces nothing)
    key <LALT> { [ NoSymbol ] };

    // Completely disable Right Alt (this also kills AltGr in most layouts)
    key <RALT> { [ NoSymbol ] };

    // Remove both Alts from the Mod1 (Alt) modifier group
    // This is the key part so apps and Sway no longer see them as Alt
    // modifier_map Mod1 { };
};
